      "role": "https://schema.org/license",
      "value": "https://spdx.org/licenses/CC-BY-NC-SA-4.0"
    }
  ],
  "inputs": {
    "product_url": {
      "title": "HTTPS URL to a Sentinel-2 product in STAC Item format.",
      "description": "",
      "schema": {
        "type": "string"
      },
      "minOccurs": 1,
      "maxOccurs": 1
    },
    "band": {
      "title": "band",
      "description": "",
      "schema": {
        "type": "string",
        "enum": [
          "B01",
          "B02",
          "B03",
          "B04",
          "B05",
          "B06",
          "B07",
          "B08",
          "B8A",
          "B09",
          "B11",
          "B12",
          "AOT",
          "SCL",
          "TCI",
          "WVP"
        ]
      },
      "minOccurs": 1,
      "maxOccurs": 1
    }
  },
  "outputs": {
    "product": {
      "title": "product",
      "description": "",
      "schema": {
        "type": "string",
        "contentMediaType": "application/octet-stream"
      }
    }
  },
  "jobControlOptions": [
    "async-execute"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ]
}