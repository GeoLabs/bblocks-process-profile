  "openeoEquivalence": {
    "level": "none",
    "rationale": "Composite (11 steps). No resampling step: the SAFE product already provides 60 m bands, so B03 60 m is downloaded directly instead of being resampled.",
    "decomposition": [
      {
        "stage": "download_b0x (x5)",
        "openeo": [
