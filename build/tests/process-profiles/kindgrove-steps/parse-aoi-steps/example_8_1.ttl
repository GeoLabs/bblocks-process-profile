@prefix pp: <https://geolabs.github.io/bblocks-process-profiles/def/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wfprov: <http://purl.org/wf4ever/wfprov#> .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/parse-aoi-steps> a skos:Concept ;
    skos:broader <https://geolabs.github.io/bblocks-process-profiles/def/phase/filter-configuration> ;
    skos:definition "Splits an OGC bounding box into its west, south, east and north coordinates." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Parse area of interest" ;
    skos:relatedMatch <https://www.opengis.net/def/bblocks/ogc.openeo.types.bounding-box> ;
    pp:cctDependency "eoap.cct.bbox" ;
    pp:openeoEquivalence [ pp:equivalenceLevel "none" ;
            pp:rationale "Structural helper: unpacks an OGC BBox record into west/south/east/north floats -- no `output_dir` (unlike `kindgrove.parse-aoi`, which this profile parallels but does not replace). No openEO process does this, since openEO passes a bounding box directly." ] ;
    pp:processDescription <https://geolabs.github.io/bblocks-process-profiles/def/process/parse_aoi> ;
    pp:profile "ospd.process-profiles.kindgrove-steps.parse-aoi-steps" ;
    pp:provenanceClass wfprov:ProcessRun ;
    pp:source [ pp:cwl <https://github.com/GeoLabs/KindGrove/releases/download/v0.0.2-rc2/mangrove-workflow-steps.cwl#parse_aoi> ;
            pp:cwlClass "CommandLineTool" ;
            pp:cwlId "parse_aoi" ;
            pp:license "https://spdx.org/licenses/CC-BY-NC-SA-4.0" ] ;
    pp:status "submitted" .

<https://geolabs.github.io/bblocks-process-profiles/def/process/parse_aoi> pp:version "0.1.0" .

