          {
            "type": "shacl",
            "code": "@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix cwl: <https://w3id.org/cwl/cwl#> .\n@prefix ogcproc: <http://www.opengis.net/def/ogcapi/processes/> .\n@prefix dct: <http://purl.org/dc/terms/> .\n@prefix s: <https://schema.org/> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix : <urn:eoap:cwl-to-ogcprocess#> .\n\n# Transform CWL Workflow to OGC Process\n:CWLWorkflowToOGCProcess\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX cwl: <https://w3id.org/cwl/cwl#>\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX dct: <http://purl.org/dc/terms/>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\n            CONSTRUCT {\n                $this a ogcproc:Process ;\n                    ogcproc:processID ?id ;\n                    ogcproc:title ?label ;\n                    ogcproc:description ?doc\n            }\n            WHERE {\n                $this a cwl:Workflow .\n                OPTIONAL { $this dct:identifier ?id }\n                OPTIONAL { $this rdfs:label ?label }\n                OPTIONAL { $this rdfs:comment ?doc }\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Transform CWL CommandLineTool to OGC Process\n:CWLCommandLineToolToOGCProcess\n    a sh:NodeShape ;\n    sh:targetClass cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX cwl: <https://w3id.org/cwl/cwl#>\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX dct: <http://purl.org/dc/terms/>\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\n            CONSTRUCT {\n                $this a ogcproc:Process ;\n                    ogcproc:processID ?id ;\n                    ogcproc:title ?label ;\n                    ogcproc:description ?doc\n            }\n            WHERE {\n                $this a cwl:CommandLineTool .\n                OPTIONAL { $this dct:identifier ?id }\n                OPTIONAL { $this rdfs:label ?label }\n                OPTIONAL { $this rdfs:comment ?doc }\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Process version.\n# NOTE: this is the version of the *application*, taken from the schema.org\n# annotations. It must not be confused with cwl:cwlVersion, which is the version\n# of the CWL language the document is written in.\n:ProcessVersion\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX s: <https://schema.org/>\n\n            CONSTRUCT {\n                $this ogcproc:version ?version\n            }\n            WHERE {\n                { $this s:softwareVersion ?version }\n                UNION\n                { $this s:version ?version\n                  FILTER NOT EXISTS { $this s:softwareVersion ?sv } }\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Preserve every schema.org annotation as an OGC API - Processes metadata entry,\n# keyed by the fully expanded IRI of the term. Terms that map onto a dedicated\n# process member (version, keywords) are excluded.\n:ProcessMetadataFromAnnotations\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX s: <https://schema.org/>\n\n            CONSTRUCT {\n                $this ogcproc:metadata [\n                    ogcproc:role ?role ;\n                    ogcproc:value ?value\n                ]\n            }\n            WHERE {\n                $this ?role ?value .\n                FILTER(STRSTARTS(STR(?role), \"https://schema.org/\")\n                    || STRSTARTS(STR(?role), \"http://schema.org/\"))\n                FILTER(?role NOT IN (s:keywords, s:version, s:softwareVersion))\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Add process execution mode metadata.\n# A CWL process is deployed through OGC API - Processes Part 2 and can only be\n# executed asynchronously, hence async-execute is the sole job control option.\n:ProcessExecutionMode\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n            CONSTRUCT {\n                $this ogcproc:jobControlOptions \"async-execute\"^^xsd:string ;\n                    ogcproc:outputTransmission \"value\"^^xsd:string ,\n                        \"reference\"^^xsd:string ;\n                    ogcproc:mutable true\n            }\n            WHERE {\n                $this a ?processClass\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Link CWL process to OGC conformance classes\n:ProcessConformance\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX dct: <http://purl.org/dc/terms/>\n\n            CONSTRUCT {\n                $this dct:conformsTo <http://www.opengis.net/spec/ogcapi-processes-1/1.0/conf/core> ,\n                    <http://www.opengis.net/spec/ogcapi-processes-1/1.0/conf/json> ,\n                    <http://www.opengis.net/spec/ogcapi-processes-2/1.0/conf/deploy-replace-undeploy> ,\n                    <https://www.commonwl.org/v1.2/>\n            }\n            WHERE {\n                $this a ?processClass\n            }\n        \"\"\" ;\n    ] ;\n.\n\n# Process keywords, from the schema.org annotation or from the CWL intent field.\n# NOTE: the previous version of this rule read prov:wasInfluencedBy, a property\n# no CWL document ever carries, so it never produced anything.\n:ProcessKeywords\n    a sh:NodeShape ;\n    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;\n    sh:rule [\n        a sh:SPARQLRule ;\n        sh:construct \"\"\"\n            PREFIX cwl: <https://w3id.org/cwl/cwl#>\n            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>\n            PREFIX s: <https://schema.org/>\n\n            CONSTRUCT {\n                $this ogcproc:keywords ?keyword\n            }\n            WHERE {\n                { $this s:keywords ?keyword }\n                UNION\n                { $this cwl:intent ?keyword }\n            }\n        \"\"\" ;\n    ] ;\n.\n"
          },
          {
