    "eoap.cct.bbox"
  ],
  "candidateCctDependencies": [],
  "hasStep": [
    "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/parse-aoi-steps",
    "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/select-scene",
    "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/download-band",
    "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/reproject-band",
