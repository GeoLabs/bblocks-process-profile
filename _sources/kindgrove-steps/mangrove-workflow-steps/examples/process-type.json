    "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac"
  ],
  "openeoEquivalence": {
    "level": "none",
    "rationale": "Composite: a CWL Workflow decomposed into one CommandLineTool per notebook, aligned on the same granularity as W1 Algae Bloom (parse AOI, select scene, download/reproject bands, compute indices, estimate biomass, export STAC) -- the workflow's own `doc:` says so explicitly. A ground-up reimplementation of `kindgrove.mangrove-workflow`'s computation, not a repackaging of it; the openEO equivalent would be a user-defined process graph.",
    "decomposition": [
      {
        "stage": "select_scene",
        "openeo": [
          "ogc.openeo.processes.cubes.load_collection"
        ],
        "level": "closeMatch"
      },
      {
        "stage": "download_band (x3, scatter over bands)",
        "openeo": [
          "ogc.openeo.processes.cubes.load_collection",
          "ogc.openeo.processes.cubes.filter_bands"
        ],
        "level": "closeMatch"
      },
      {
        "stage": "reproject_band (x3)",
        "openeo": [
          "ogc.openeo.processes.cubes.resample_spatial"
        ],
        "level": "closeMatch"
      },
      {
        "stage": "calculate_indices",
        "openeo": [
          "ogc.openeo.processes.cubes.ndvi",
          "ogc.openeo.processes.math.indices.normalized_difference"
        ],
        "level": "closeMatch",
        "note": "NDVI and NDWI; SAVI has no openEO process in this register"
      },
      {
        "stage": "estimate_biomass",
        "openeo": [],
        "level": "none",
        "note": "opaque allometric regression + IPCC carbon fraction"
      },
      {
        "stage": "export_stac",
        "openeo": [
          "ogc.openeo.processes.cubes.save_result"
        ],
        "level": "closeMatch"
      }
    ]
  }
}
